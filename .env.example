# Copy to .env and fill in
DATABASE_URL=postgres://ballast_user:ballast_password@localhost:5432/ballast_db
# Optional for a managed database that uses a private CA: base64 of the PEM chain.
DATABASE_SSL_CA_BASE64=
# Stable secret used only to hash in-memory waitlist rate-limit keys.
WAITLIST_RATE_LIMIT_SECRET=
OPENAI_API_KEY=sk-...
